# ChatService's own Postgres (stores chat threads + messages)
DATABASE_URL=
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Auth (JWT) — must match the other services
JWT_SECRET=
JWT_ALGORITHM=HS256

# Kafka — consumes dbservice.dbconnection to replicate connection schemas
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# DBService — sync connection-ownership validation at thread creation
DBSERVICE_URL=http://db-service:8003
DBSERVICE_TIMEOUT=10.0

# ML service (Text-to-SQL SSE endpoint)
MLSERVICE_URL=http://sqlgen-serve.ml.svc.cluster.local:8000
MLSERVICE_STREAM_PATH=/stream-query
MLSERVICE_TIMEOUT=120.0

# App
APP_NAME=ChatService
APP_HOST=0.0.0.0
APP_PORT=8004
DEBUG=False
ROOT_PATH=chat
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=

# CORS
CORS_ORIGINS=http://localhost:3000
